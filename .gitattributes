# Git Large File Storage (LFS) & Binary Asset Configuration
# 3D Models & Geometry
*.bin filter=lfs diff=lfs merge=lfs -text binary
*.gltf filter=lfs diff=lfs merge=lfs -text binary
*.glb filter=lfs diff=lfs merge=lfs -text binary
*.obj filter=lfs diff=lfs merge=lfs -text binary
*.fbx filter=lfs diff=lfs merge=lfs -text binary

# Textures & Images
*.png filter=lfs diff=lfs merge=lfs -text binary
*.jpg filter=lfs diff=lfs merge=lfs -text binary
*.jpeg filter=lfs diff=lfs merge=lfs -text binary
*.webp filter=lfs diff=lfs merge=lfs -text binary

# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text binary
*.woff filter=lfs diff=lfs merge=lfs -text binary
*.woff2 filter=lfs diff=lfs merge=lfs -text binary

# Audio
*.mp3 filter=lfs diff=lfs merge=lfs -text binary
*.wav filter=lfs diff=lfs merge=lfs -text binary
*.ogg filter=lfs diff=lfs merge=lfs -text binary

# Lo que la web sirve en producción va como archivo normal (< 1 MB en total):
# así el deploy no depende de que la plataforma descargue Git LFS.
apps/web/public/** -filter -diff -merge -text
project-logo.png -filter -diff -merge -text

# Semilla de imágenes de la demo: archivos normales, el deploy no depende de LFS.
apps/server/seed/** -filter -diff -merge -text
